// 测谎仪管理面板 - 前端逻辑
let currentUserId = null;
let editingRecordId = null;
let confirmCallback = null;
let bridge = null;

// 等待 bridge 准备就绪
function waitForBridge() {
    return new Promise((resolve, reject) => {
        // 如果已经存在
        if (window.AstrBotPluginPage) {
            resolve(window.AstrBotPluginPage);
            return;
        }

        // 设置超时
        const timeout = setTimeout(() => {
            reject(new Error(
                'AstrBotPluginPage bridge 不可用\n\n' +
                '请通过 AstrBot WebUI 访问此页面：\n' +
                '1. 打开 AstrBot WebUI（如 http://localhost:6185）\n' +
                '2. 进入「插件管理」页面\n' +
                '3. 找到「测谎仪」插件\n' +
                '4. 点击「查看页面」按钮\n\n' +
                '不要直接访问 HTML 文件！'
            ));
        }, 5000);

        // 轮询检查
        const checkInterval = setInterval(() => {
            if (window.AstrBotPluginPage) {
                clearTimeout(timeout);
                clearInterval(checkInterval);
                resolve(window.AstrBotPluginPage);
            }
        }, 100);

        // 监听 message 事件（bridge 可能通过 postMessage 注入）
        window.addEventListener('message', function handler(event) {
            if (window.AstrBotPluginPage) {
                clearTimeout(timeout);
                clearInterval(checkInterval);
                window.removeEventListener('message', handler);
                resolve(window.AstrBotPluginPage);
            }
        });
    });
}

// 初始化
async function init() {
    try {
        console.log('[测谎仪] 等待 bridge 初始化...');
        bridge = await waitForBridge();
        console.log('[测谎仪] Bridge 已就绪');

        // 调用 bridge.ready()
        if (typeof bridge.ready === 'function') {
            await bridge.ready();
            console.log('[测谎仪] Bridge ready() 完成');
        }

        // 加载数据
        loadData();
    } catch (error) {
        console.error('[测谎仪] 初始化失败:', error);
        showToast('初始化失败: ' + error.message);
    }
}

// 加载所有数据
async function loadData() {
    if (!bridge) {
        showToast('Bridge 未初始化');
        return;
    }

    try {
        console.log('[测谎仪] 加载统计数据...');
        const stats = await bridge.apiGet('stats');
        console.log('[测谎仪] 统计数据:', stats);
        updateStats(stats);

        console.log('[测谎仪] 加载用户列表...');
        const users = await bridge.apiGet('users');
        console.log('[测谎仪] 用户列表:', users);
        renderUserList(users);

        showToast('数据加载成功');
    } catch (error) {
        console.error('[测谎仪] 加载数据失败:', error);
        showToast('加载失败: ' + error.message);
    }
}

// 更新统计显示
function updateStats(stats) {
    document.getElementById('statUsers').textContent = stats.total_users || 0;
    document.getElementById('statChecks').textContent = stats.total_checks || 0;
    document.getElementById('statAvg').textContent = (stats.overall_avg || 0).toFixed(1) + '%';
}

// 渲染用户列表
function renderUserList(users) {
    const tbody = document.getElementById('userTableBody');

    if (!users || users.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty">暂无测谎记录</td></tr>';
        return;
    }

    tbody.innerHTML = users.map((user, index) => {
        const rank = index + 1;
        const rankIcon = rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : rank;
        const avgScore = Math.round(user.avg_score);

        return `
            <tr onclick="showUserDetail('${user.user_id}', '${user.user_name || user.user_id}')">
                <td>${rankIcon}</td>
                <td>${user.user_name || user.user_id}</td>
                <td><span class="score-badge">${avgScore}%</span></td>
                <td>${user.icon} ${user.level}</td>
                <td>${user.total_checks}</td>
                <td>
                    <button class="btn btn-sm" onclick="event.stopPropagation(); showUserDetail('${user.user_id}', '${user.user_name || user.user_id}')">查看</button>
                </td>
            </tr>
        `;
    }).join('');
}

// 显示用户详情
async function showUserDetail(userId, userName) {
    currentUserId = userId;

    document.getElementById('userListView').classList.remove('active');
    document.getElementById('userDetailView').classList.add('active');
    document.getElementById('detailTitle').textContent = `玩家详情 — ${userName}`;

    try {
        console.log('[测谎仪] 加载用户详情:', userId);

        // 获取用户信息
        const users = await bridge.apiGet('users');
        const user = users.find(u => u.user_id === userId);

        if (user) {
            document.getElementById('detailSummary').innerHTML = `
                <div class="summary-item">
                    <span class="summary-label">平均分</span>
                    <span class="summary-value">${Math.round(user.avg_score)}%</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">等级</span>
                    <span class="summary-value">${user.icon} ${user.level}</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">测谎次数</span>
                    <span class="summary-value">${user.total_checks}</span>
                </div>
            `;
        }

        // 获取用户记录 - 使用第二个参数传递查询参数
        const records = await bridge.apiGet('records', { user_id: userId });
        console.log('[测谎仪] 用户记录:', records);
        renderRecords(records);

    } catch (error) {
        console.error('[测谎仪] 加载用户详情失败:', error);
        showToast('加载失败: ' + error.message);
    }
}

// 存储当前用户的记录数据，用于详情页显示
let currentRecords = [];

// 渲染记录列表（简化版：只显示编号和等级）
function renderRecords(records) {
    const tbody = document.getElementById('recordTableBody');
    currentRecords = records || [];

    if (!records || records.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" class="empty">该用户暂无测谎记录</td></tr>';
        return;
    }

    tbody.innerHTML = records.map((record, index) => {
        const recordId = record.id;
        return `
            <tr>
                <td>#${recordId}</td>
                <td>${record.icon} ${record.level}</td>
                <td>
                    <button class="btn btn-sm btn-primary" onclick="showRecordDetail(${recordId})">查看详情</button>
                </td>
            </tr>
        `;
    }).join('');
}

// 显示记录详情页
function showRecordDetail(recordId) {
    const record = currentRecords.find(r => r.id === recordId);
    if (!record) {
        showToast('记录不存在');
        return;
    }

    const score = Math.round(record.score);
    const createdTime = record.created_at || '-';
    const reason = record.reason || '无';
    const message = record.message_preview || '无';
    const sourceGroup = record.source_group || '私聊';

    document.getElementById('recordDetailContent').innerHTML = `
        <div class="record-detail-section">
            <div class="record-detail-label">评分</div>
            <div class="record-detail-score">
                <span class="score-badge">${score}%</span>
                <span>${record.icon} ${record.level}</span>
            </div>
        </div>

        <div class="record-detail-section">
            <div class="record-detail-label">判断理由</div>
            <div class="record-detail-value">${reason}</div>
        </div>

        <div class="record-detail-section">
            <div class="record-detail-label">原文</div>
            <div class="record-detail-value original-message">${message}</div>
        </div>

        <div class="record-detail-meta">
            <div class="record-detail-meta-item">记录编号: #${recordId}</div>
            <div class="record-detail-meta-item">测谎时间: ${createdTime}</div>
            <div class="record-detail-meta-item">来源群: ${sourceGroup}</div>
        </div>
    `;

    document.getElementById('userDetailView').classList.remove('active');
    document.getElementById('recordDetailView').classList.add('active');
}

// 返回用户详情页
function backToUserDetail() {
    document.getElementById('recordDetailView').classList.remove('active');
    document.getElementById('userDetailView').classList.add('active');
}

// 返回用户列表
function showUserList() {
    currentUserId = null;
    document.getElementById('userDetailView').classList.remove('active');
    document.getElementById('userListView').classList.add('active');
    loadData();
}

// 打开编辑弹窗
function openEditModal(recordId, currentScore, reason) {
    editingRecordId = recordId;
    document.getElementById('editScoreInput').value = currentScore;
    document.getElementById('editRecordInfo').textContent = reason ? `原理由: ${reason}` : '';
    document.getElementById('editModal').classList.add('active');
}

// 关闭编辑弹窗
function closeEditModal() {
    document.getElementById('editModal').classList.remove('active');
    editingRecordId = null;
}

// 保存编辑
async function saveEdit() {
    const newScore = parseInt(document.getElementById('editScoreInput').value);
    if (isNaN(newScore) || newScore < 0 || newScore > 100) {
        showToast('请输入0-100之间的整数');
        return;
    }

    try {
        console.log('[测谎仪] 更新记录:', editingRecordId, newScore);
        await bridge.apiPost('records/update', {
            record_id: editingRecordId,
            score: newScore
        });

        showToast('修改成功');
        closeEditModal();

        if (currentUserId) {
            const users = await bridge.apiGet('users');
            const user = users.find(u => u.user_id === currentUserId);
            if (user) {
                showUserDetail(currentUserId, user.user_name || currentUserId);
            }
        }
    } catch (error) {
        console.error('[测谎仪] 修改失败:', error);
        showToast('修改失败: ' + error.message);
    }
}

// 删除记录
function deleteRecord(recordId) {
    showConfirm('删除记录', '确定要删除这条测谎记录吗？删除后不可恢复。', async () => {
        try {
            console.log('[测谎仪] 删除记录:', recordId);
            await bridge.apiPost('records/delete', { record_id: recordId });

            showToast('删除成功');

            if (currentUserId) {
                const users = await bridge.apiGet('users');
                const user = users.find(u => u.user_id === currentUserId);
                if (user) {
                    showUserDetail(currentUserId, user.user_name || currentUserId);
                } else {
                    showUserList();
                }
            }
        } catch (error) {
            console.error('[测谎仪] 删除失败:', error);
            showToast('删除失败: ' + error.message);
        }
    });
}

// 重置用户
function resetCurrentUser() {
    if (!currentUserId) return;

    showConfirm('重置用户', '确定要清除该用户的所有测谎数据吗？此操作不可恢复！', async () => {
        try {
            console.log('[测谎仪] 重置用户:', currentUserId);
            await bridge.apiPost('users/reset', { user_id: currentUserId });

            showToast('已清除用户数据');
            showUserList();
        } catch (error) {
            console.error('[测谎仪] 重置失败:', error);
            showToast('重置失败: ' + error.message);
        }
    });
}

// 显示确认弹窗
function showConfirm(title, message, callback) {
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmMessage').textContent = message;
    confirmCallback = callback;
    document.getElementById('confirmModal').classList.add('active');

    document.getElementById('confirmOkBtn').onclick = () => {
        closeConfirm();
        if (confirmCallback) confirmCallback();
    };
}

// 关闭确认弹窗
function closeConfirm() {
    document.getElementById('confirmModal').classList.remove('active');
    confirmCallback = null;
}

// 显示提示
function showToast(message) {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
}

// 暴露到全局
window.loadData = loadData;
window.showUserDetail = showUserDetail;
window.showUserList = showUserList;
window.showRecordDetail = showRecordDetail;
window.backToUserDetail = backToUserDetail;
window.openEditModal = openEditModal;
window.closeEditModal = closeEditModal;
window.saveEdit = saveEdit;
window.deleteRecord = deleteRecord;
window.resetCurrentUser = resetCurrentUser;
window.closeConfirm = closeConfirm;

// 启动
init();
